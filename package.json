{
  "name": "educore-backend",
  "version": "1.0.0",
  "description": "EduCore School ERP — Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "npx sequelize-cli db:migrate --config config/sequelize-config.js && node server.js",
    "dev": "nodemon server.js",
    "db:test": "node -e \"require('./config/database').authenticate().then(() => { console.log('✅ DB connected'); process.exit(0); }).catch(e => { console.error('❌', e.message); process.exit(1); })\"",
    "db:migrate": "npx sequelize-cli db:migrate --config config/sequelize-config.js",
    "db:seed:all": "npx sequelize-cli db:seed:all --config config/sequelize-config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^8.0.9",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^24.42.0",
    "rate-limit-redis": "^5.0.0",
    "sequelize": "^6.37.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "overrides": {
    "protobufjs": "^8.0.1",
    "basic-ftp": "^6.0.0",
    "undici": "^7.26.0",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5"
  }
}
